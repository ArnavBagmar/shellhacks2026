# cp .env.example .env  --  .env is gitignored and must stay that way.
# `./startcane` refuses to run without GEMINI_API_KEY and checks this file first.
# Quote any value containing spaces: uv's .env reader silently drops unquoted ones.

# REQUIRED for the laptop's scene/voice half (Gemini answers the spoken questions).
# Each person uses their OWN key -- aistudio.google.com/apikey. Free tier is enough.
GEMINI_API_KEY=AQ.Ab8RN6L8Qrs0gKj71jGHkLk0S8uUtzGuCBFn5t_FsyGimMcx2g

# OPTIONAL: the natural answer voice. Without it the phone speaks in its own voice,
# which is a downgrade, not a failure.
ELEVENLABS_API_KEY=

# OPTIONAL: where the wearer is, so weather and "what's nearby" questions have
# context. Open-Meteo needs NO key. Set one of these two.
# CANE_LOCATION="FIU, Miami, Florida"
# CANE_LAT_LON=25.7574,-80.3739
# CANE_TEMP_UNIT=F

# --- Indoor wayfinding: the background sign sweep ------------------------
# With --scene the laptop reads the building's signage off the 360 crops every
# few seconds and remembers it for the session, so "where is the nearest
# restroom" can be answered about a sign the wearer already walked past. The
# same sweep reports indoor/outdoor, which is how the laptop knows whether to
# keep spending model calls at all (outdoors the phone's Maps engine owns
# navigation and the sweep slows right down).
# Memory is in-session only: it dies with the process, nothing is written to disk.
# CANE_SIGN_SCAN=off          # switch the sweep off entirely
# CANE_SIGN_SCAN_INTERVAL_S=4 # seconds between sweeps (about every 5 m walking)

# --- Not secrets, but the knobs a second laptop usually needs ---
# The depth head defaults ON; these pick the device and the local detector.
# CANE_DETECTOR=ultralytics
# CANE_DEVICE=mps
# CANE_DEPTH_DEVICE=mps

# NOTE: there is no key for the L4 inference VM. Access is by firewall, not by
# secret: the rule allows tcp:8000 from ONE laptop's public /32. A second laptop
# is dropped, the health monitor sees three timeouts and flips to the local
# detector -- where depth is deliberately off, so NO steer frames are produced.
# That looks like "steering is broken". Run the service on your own laptop
# instead (docs/steps/step-25-brief.md Sec 0, option A) unless your IP has been
# added to the rule.

# --- One-time setup a fresh clone needs (NOT in git, ~95 MiB) -------------
# Without these the depth head cannot load, so there are NO steer frames and
# ./startcane full refuses to start. From backend/:
#   mkdir -p third_party checkpoints
#   git clone https://github.com/DepthAnything/Depth-Anything-V2.git third_party/Depth-Anything-V2
#   git -C third_party/Depth-Anything-V2 checkout a561b849ebae10a6f5ef49e26c83cbbcd36c71bf
#   curl -L --fail --retry 2 https://huggingface.co/depth-anything/Depth-Anything-V2-Small/resolve/main/depth_anything_v2_vits.pth -o checkpoints/depth_anything_v2_vits.pth
# yolo11s.pt is also ignored; ultralytics downloads it on first use.
