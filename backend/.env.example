# cp .env.example .env  --  .env is gitignored and must stay that way.
# `./startcane` refuses to run without GEMINI_API_KEY and checks this file first.
# Quote any value containing spaces: uv's .env reader silently drops unquoted ones.

# REQUIRED for the laptop's scene/voice half (Gemini answers the spoken questions).
# Each person uses their OWN key -- aistudio.google.com/apikey. Free tier is enough.
GEMINI_API_KEY=

# OPTIONAL: the natural answer voice. Without it the phone speaks in its own voice,
# which is a downgrade, not a failure.
ELEVENLABS_API_KEY=

# OPTIONAL: where the wearer is, so weather and "what's nearby" questions have
# context. Open-Meteo needs NO key. Set one of these two.
# CANE_LOCATION="FIU, Miami, Florida"
# CANE_LAT_LON=25.7574,-80.3739
# CANE_TEMP_UNIT=F

# --- Not secrets, but the knobs a second laptop usually needs ---
# The depth head defaults ON; these pick the device and the local detector.
# CANE_DETECTOR=ultralytics
# CANE_DEVICE=mps
# CANE_DEPTH_DEVICE=mps

# NOTE: there is no key for the L4 inference VM. Access is by firewall, not by
# secret: the rule allows tcp:8000 from ONE laptop's public /32. A second laptop
# is dropped, the health monitor sees three timeouts and flips to the local
# detector -- where depth is deliberately off, so NO steer frames are produced.
# That looks like "steering is broken". Run the service on your own laptop
# instead (docs/steps/step-25-brief.md Sec 0, option A) unless your IP has been
# added to the rule.
