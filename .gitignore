.DS_Store
.venv/
__pycache__/
*.pyc
.pytest_cache/
.build/
*.xcuserstate
.swiftpm/

# perception benchmarks: run artifacts, model weights and vendored sources
benchmark_runs/
*.pt
*.ts
backend/third_party/
backend/checkpoints/

# step 7: local YOLO env, weights and TensorRT engines are never committed
.venv-yolo/
*.engine
*.engine.json
yolo11s.pt
*.mlpackage

# step 20: the phone app -- the Xcode project is generated from project.yml
# (xcodegen), and signing team / Maps key live in an uncommitted xcconfig.
ios/CaneApp/*.xcodeproj
ios/CaneApp/Config/Local.xcconfig
xcuserdata/

# walk logs (laptop + the phone's diag stream) -- local only, may hold transcripts
backend/logs/

# local secrets (GEMINI_API_KEY etc.) -- never committed
.env
.env.*
!.env.example

# xcodebuild -derivedDataPath output (./startcane phone)
ios/CaneApp/build/
